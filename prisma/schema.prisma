generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Player {
  id        String   @id @default(cuid())
  nome      String
  cognome   String
  email     String?  @unique
  telefono  String?
  fotoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamAsPlayer1 Team? @relation("TeamPlayer1")
  teamAsPlayer2 Team? @relation("TeamPlayer2")
}

model Team {
  id        String   @id @default(cuid())
  nome      String
  genere    String
  livello   Int      @default(0)
  player1Id String   @unique
  player1   Player   @relation("TeamPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2Id String   @unique
  player2   Player   @relation("TeamPlayer2", fields: [player2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchesAsTeam1 Match[] @relation("Team1")
  matchesAsTeam2 Match[] @relation("Team2")
  matchesWon     Match[] @relation("Winner")
}

model Tournament {
  id        String   @id @default(cuid())
  nome      String
  genere    String
  stato     String   @default("BOZZA")
  anno      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  round     Int
  posizione Int

  team1Id String?
  team1   Team?   @relation("Team1", fields: [team1Id], references: [id], onDelete: SetNull)
  team2Id String?
  team2   Team?   @relation("Team2", fields: [team2Id], references: [id], onDelete: SetNull)

  winnerId String?
  winner   Team?   @relation("Winner", fields: [winnerId], references: [id], onDelete: SetNull)

  punteggio String?

  stato      String    @default("ATTESA")
  iniziataAt DateTime?
  finitaAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
