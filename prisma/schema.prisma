generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Sponsor {
  id        String   @id @default(cuid())
  nome      String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]
}

model Field {
  id           String   @id @default(cuid())
  nome         String
  descrizione  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matches Match[]
}

model Player {
  id        String   @id @default(cuid())
  nome      String
  cognome   String
  email     String?  @unique
  telefono  String?
  fotoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamAsPlayer1 Team? @relation("TeamPlayer1")
  teamAsPlayer2 Team? @relation("TeamPlayer2")
}

model Team {
  id        String   @id @default(cuid())
  nome      String
  genere    String
  livello   Int      @default(0)
  player1Id String   @unique
  player1   Player   @relation("TeamPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2Id String   @unique
  player2   Player   @relation("TeamPlayer2", fields: [player2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchesAsTeam1 Match[]     @relation("Team1")
  matchesAsTeam2 Match[]     @relation("Team2")
  matchesWon     Match[]     @relation("Winner")
  groupTeams     GroupTeam[]
}

model Tournament {
  id        String   @id @default(cuid())
  nome      String
  genere    String
  stato     String   @default("BOZZA")
  fase      String   @default("GIRONI")
  anno      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]
  groups  Group[]

  @@index([genere, stato])
}

model Group {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  nome         String
  posizione    Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  groupTeams GroupTeam[]
  matches    Match[]

  @@index([tournamentId])
}

model GroupTeam {
  id              String   @id @default(cuid())
  groupId         String
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seed            Int?
  punti           Int      @default(0)
  gameVinti       Int      @default(0)
  gamePersi       Int      @default(0)
  matchGiocate    Int      @default(0)
  posizioneFinale Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([groupId, teamId])
  @@index([teamId])
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  bracketTipo String?

  round     Int
  posizione Int

  team1Id String?
  team1   Team?   @relation("Team1", fields: [team1Id], references: [id], onDelete: SetNull)
  team2Id String?
  team2   Team?   @relation("Team2", fields: [team2Id], references: [id], onDelete: SetNull)

  winnerId String?
  winner   Team?   @relation("Winner", fields: [winnerId], references: [id], onDelete: SetNull)

  sponsorId String?
  sponsor   Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)

  fieldId String?
  field   Field?  @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  punteggio     String?
  set1Team1     Int?
  set1Team2     Int?
  tieBreakTeam1 Int?
  tieBreakTeam2 Int?

  stato      String    @default("ATTESA")
  iniziataAt DateTime?
  finitaAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
  @@index([groupId])
  @@index([team1Id])
  @@index([team2Id])
  @@index([winnerId])
  @@index([stato])
  @@index([sponsorId])
  @@index([fieldId])
}
